{
  "name": "cardipal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-global-shortcut": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "^2.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "tauri": "tauri",
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "check:reproducible": "cargo check --locked --release --manifest-path src-tauri/Cargo.toml",
    "check:frontend": "npm run test && npm run build",
    "check:rust": "cargo clippy --release --manifest-path src-tauri/Cargo.toml --no-deps -- -D warnings",
    "check:uia": "cargo check --manifest-path src-tauri/Cargo.toml --features uia-diagnostics",
    "check:release": "npm run check:reproducible && npm run check:frontend && npm run check:rust",
    "release": "npm run check:release && tauri build",
    "build:release": "npm run release",
    "dev:standard": "cross-env VITE_UIA_DIAGNOSTICS=false tauri dev",
    "dev:uia": "cross-env VITE_UIA_DIAGNOSTICS=true tauri dev --features uia-diagnostics"
  }
}
